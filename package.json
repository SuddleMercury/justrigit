  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.0",
    "fflate": "^0.8.3",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.17"
  },
  "type": "module",
  "bin": {
    "justrigit-mcp": "src/node/mcp-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuddleMercury/justrigit.git"
  },
