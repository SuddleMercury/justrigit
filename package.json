{
  "name": "justrigit",
  "version": "0.3.0",
  "description": "JustRigIt \u2014 auto-rig, retarget, fix and export 3D characters for Unreal, Unity, Godot and Blender. Web app + MCP server.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "mcpb": "node scripts/build-mcpb.mjs",
    "mcp": "node src/node/mcp-server.mjs",
    "mcp:http": "node src/node/mcp-server.mjs --http 8787",
    "test": "node scripts/m2test.mjs && node scripts/mcptest.mjs"
  },
  "keywords": [],
